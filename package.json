{
  "name": "cake-website",
  "version": "1.0.0",
  "private": true,
  "description": "Independent cake storefront with an imported catalog and order requests",
  "scripts": {
    "start": "node server.js",
    "build:vercel": "node scripts/build-vercel.cjs",
    "test": "node --test tests/*.test.js",
    "import": "node scripts/restore-original-inventory.cjs",
    "test:browser": "playwright test",
    "orders": "node scripts/list-orders.js",
    "enquiries": "node scripts/list-enquiries.js",
    "build:images": "node scripts/build-responsive-images.cjs",
    "build:identity": "node scripts/build-site-icons.cjs",
    "prestart": "npm run build:images",
    "pretest": "npm run build:images",
    "pretest:browser": "npm run build:images"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4"
  }
}
